# ── Alibaba Cloud Model Studio (DashScope) ─────────────────────────
# Get your API key at: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-key-here
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Vision-Language model for frame analysis
VL_MODEL=qwen3-vl-235b-a22b-instruct
# Text model for rule refinement and digest generation
TEXT_MODEL=qwen-plus

# ── Camera settings ────────────────────────────────────────────────
# USB webcam index (0 = first camera). Ignored in Demo mode.
CAMERA_INDEX=0

# ── Detection settings ─────────────────────────────────────────────
# Seconds between each frame analysis while monitoring
POLL_INTERVAL=3
# Minimum pixel-difference score to trigger a VLM call (motion gate)
MOTION_THRESHOLD=8.0
# Max concurrent rule evaluations per frame
MAX_PARALLEL_RULES=4

# ── Telegram notifications ──────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (get it from @userinfobot)
TELEGRAM_CHAT_ID=
# Set to false to disable all Telegram sends
ESCALATION_ENABLED=true
# Seconds before the same rule+zone can trigger another message
ESCALATION_COOLDOWN_SECONDS=60

# ── Demo mode ──────────────────────────────────────────────────────
# Set DEMO_MODE=true to auto-start with the sample video on boot
DEMO_MODE=false
# Path to a video file for demo mode (leave empty for built-in canvas scene)
DEMO_VIDEO_PATH=
